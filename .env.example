# Neon Postgres. Never commit the real value.
DATABASE_URL="postgresql://..."

# Automatically provided when a Vercel Blob store is connected to this project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Portfolio admin. Use strong private values in Vercel Environment Variables.
ADMIN_PASSWORD="change-this"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
